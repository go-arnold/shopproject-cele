# ===================================================================
#                    CELEBOBO ENVIRONMENT CONFIGURATION
# ===================================================================
# Copy this file to .env and fill in the actual values for your environment
# 
# Format:
# - Required variables: must be set (no default provided)
# - Optional variables: have defaults shown in comments
# - Secrets: keep these private and never commit to version control
#
# Python: 3.12+
# Django: 5.2
# PostgreSQL: 15
# ===================================================================


# ────────────────────────────────────────────────────────────────
#                    DJANGO CORE CONFIGURATION
# ────────────────────────────────────────────────────────────────

# Django security key (generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())")
# REQUIRED - Keep this secret and unique per environment
SECRET_KEY=your-secret-key-here-change-in-production

# Debug mode (True/False)
# REQUIRED - Set to False in production
DEBUG=True

# Allowed hosts for this Django instance (comma-separated)
# REQUIRED - Update with your domain names
ALLOWED_HOSTS=localhost,127.0.0.1,app,*.yourdomain.com

# Application mode (dev/prod/worker/scheduler/web)
# Optional - default: dev
# - dev: All services in one container (local development)
# - prod: Gunicorn + Supervisor + Celery (single VPS)
# - worker: Celery only (horizontal scaling)
# - scheduler: Celery Beat only (one instance max)
# - web: Gunicorn only (microservice)
APP_MODE=dev

# Logging level (DEBUG/INFO/WARNING/ERROR/CRITICAL)
# Optional - default: INFO
LOG_LEVEL=INFO


# ────────────────────────────────────────────────────────────────
#                    DATABASE CONFIGURATION
# ────────────────────────────────────────────────────────────────

# PostgreSQL connection string
# REQUIRED - Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/shopproject

# For development, you can also use individual settings:
# DB_HOST=localhost
# DB_NAME=shopproject
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_PORT=5432


# ────────────────────────────────────────────────────────────────
#                    CACHE & MESSAGE BROKER (REDIS)
# ────────────────────────────────────────────────────────────────

# Redis connection URL
# REQUIRED - Format: redis://[:password]@host:port/db
# Default: redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# Redis URL for Celery broker (if different from REDIS_URL)
# Optional - defaults to REDIS_URL
CELERY_BROKER_URL=redis://localhost:6379/0

# Redis URL for Celery result backend
# Optional - if not set, uses PostgreSQL (django-celery-results)
CELERY_RESULT_BACKEND=


# ────────────────────────────────────────────────────────────────
#                    AI ASSISTANT (GEMINI)
# ────────────────────────────────────────────────────────────────

# Google Gemini API Key
# REQUIRED for AI features - Get from: https://ai.google.dev
GEMINI_API_KEY=your-gemini-api-key-here

# Gemini model name
# Optional - default: gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash

# API request timeout (seconds)
# Optional - default: 30
GEMINI_TIMEOUT=30

# Response cache timeout (seconds)
# Optional - default: 300 (5 minutes)
GEMINI_CACHE_TIMEOUT=300

# Maximum messages in conversation history
# Optional - default: 6
GEMINI_MAX_HISTORY=6

# Maximum length of user message (characters)
# Optional - default: 500
GEMINI_MAX_MESSAGE_LENGTH=500

# Maximum tokens in AI response
# Optional - default: 800
GEMINI_MAX_TOKENS=800

# Temperature for generation (0.0-1.0, lower = more deterministic)
# Optional - default: 0.7
GEMINI_TEMPERATURE=0.3

# Top-p for sampling (nucleus sampling)
# Optional - default: 0.95
GEMINI_TOP_P=0.95


# ────────────────────────────────────────────────────────────────
#                    FILE STORAGE (CLOUDINARY)
# ────────────────────────────────────────────────────────────────

# Cloudinary account name
# REQUIRED for image uploads - Get from: https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your-cloud-name-here

# Cloudinary API Key
# REQUIRED - Get from Cloudinary dashboard
CLOUDINARY_API_KEY=your-cloudinary-api-key-here

# Cloudinary API Secret
# REQUIRED - Keep this secret!
CLOUDINARY_API_SECRET=your-cloudinary-api-secret-here


# ────────────────────────────────────────────────────────────────
#                    EMAIL CONFIGURATION
# ────────────────────────────────────────────────────────────────

# Email backend
# Optional - default: django.core.mail.backends.console.EmailBackend (prints to console)
# For production: django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# SMTP Host
# Optional - required if using SMTP backend
EMAIL_HOST=smtp.gmail.com

# SMTP Port
# Optional - default: 587 (for TLS)
EMAIL_PORT=587

# Use TLS encryption
# Optional - default: True
EMAIL_USE_TLS=True

# SMTP Username
# Optional - required if using SMTP backend
EMAIL_HOST_USER=your-email@gmail.com

# SMTP Password (use app-specific password for Gmail)
# Optional - required if using SMTP backend
EMAIL_HOST_PASSWORD=your-app-specific-password-here

# Default sender email address
# Optional - default: noreply@example.com
DEFAULT_FROM_EMAIL=noreply@celebobo.com

# Support email address
# Optional - for displaying in contact forms
SUPPORT_EMAIL=support@celebobo.com


# ────────────────────────────────────────────────────────────────
#                    PRODUCT ANALYTICS CONFIGURATION
# ────────────────────────────────────────────────────────────────

# Number of top products to track and report
# Optional - default: 15
PRODUCT_ANALYTICS_TOP_N=15

# Email recipients for weekly analytics report (comma-separated)
# Optional - no default, skips email if not set
PRODUCT_ANALYTICS_EMAIL_RECIPIENTS=admin@celebobo.com,analytics@celebobo.com

# Day to send weekly analytics report
# Optional - default: "monday"
# Options: monday, tuesday, wednesday, thursday, friday, saturday, sunday
PRODUCT_ANALYTICS_SEND_DAY=monday

# Time to send analytics report (24-hour format)
# Optional - default: "09:00"
PRODUCT_ANALYTICS_SEND_TIME=09:00

# Number of days to keep analytics data
# Optional - default: 90 (older data is deleted)
PRODUCT_ANALYTICS_RETENTION_DAYS=90


# ────────────────────────────────────────────────────────────────
#                    SITE CONFIGURATION
# ────────────────────────────────────────────────────────────────

# Site name (displayed in emails, templates, etc.)
# Optional - default: "Celebobo"
SITE_NAME=Celebobo

# Site URL (for absolute links)
# Optional - used in email templates
SITE_URL=https://celebobo.com

# Support phone number
# Optional - displayed in error messages
SUPPORT_PHONE=+250791449879


# ────────────────────────────────────────────────────────────────
#                    CELERY / BACKGROUND TASKS
# ────────────────────────────────────────────────────────────────

# Note: Celery configuration is mostly automatic from DATABASE_URL and REDIS_URL
# These are advanced settings for fine-tuning:

# Celery task time limit (seconds)
# Optional - tasks that run longer are killed
CELERY_TASK_TIME_LIMIT=600

# Celery task soft time limit (seconds)
# Optional - tasks receive SoftTimeLimitExceeded exception before hard limit
CELERY_TASK_SOFT_TIME_LIMIT=580

# Number of worker processes
# Optional - default: 4
CELERY_WORKER_CONCURRENCY=4

# Accept content types
# Optional - default: json,msgpack
CELERY_ACCEPT_CONTENT=json,msgpack

# Timezone for Celery Beat scheduler
# Optional - default: UTC
CELERY_TIMEZONE=UTC


# ────────────────────────────────────────────────────────────────
#                    EXTERNAL SERVICES
# ────────────────────────────────────────────────────────────────

# Analytics service (e.g., DataDog, New Relic)
# Optional - leave empty if not using
ANALYTICS_API_KEY=

# APM (Application Performance Monitoring) service
# Optional - for production monitoring
APM_SERVICE_NAME=celebobo
APM_SERVICE_VERSION=1.0.0


# ────────────────────────────────────────────────────────────────
#                    OPTIONAL FEATURE FLAGS
# ────────────────────────────────────────────────────────────────

# Enable AI assistant
# Optional - default: True
ENABLE_AI_ASSISTANT=True

# Enable product analytics
# Optional - default: True
ENABLE_PRODUCT_ANALYTICS=True

# Enable email reports
# Optional - default: True
ENABLE_EMAIL_REPORTS=True

# Enable PDF exports
# Optional - default: True
ENABLE_PDF_EXPORTS=True

# Enable Excel exports
# Optional - default: True
ENABLE_EXCEL_EXPORTS=True


# ────────────────────────────────────────────────────────────────
#                    SECURITY HEADERS
# ────────────────────────────────────────────────────────────────

# Secure SSL Redirect (only in production with HTTPS)
# Optional - default: False
SECURE_SSL_REDIRECT=False

# HTTP Strict Transport Security max age
# Optional - default: 31536000 (1 year)
SECURE_HSTS_SECONDS=31536000

# CSRF trusted origins (comma-separated)
# Optional - required for CSRF protection across domains
CSRF_TRUSTED_ORIGINS=https://celebobo.com,https://www.celebobo.com


# ────────────────────────────────────────────────────────────────
#                    DEVELOPMENT SETTINGS (LOCAL ONLY)
# ────────────────────────────────────────────────────────────────

# These settings are for local development. Do NOT use in production.

# Django toolbar (local development only)
# Optional - default: False
ENABLE_DJANGO_TOOLBAR=False

# Verbose logging (local development only)
# Optional - default: False
VERBOSE_LOGGING=False

# Use Django dev server (local development only)
# Optional - default: False
USE_DEV_SERVER=False
